{
  "name": "schemesetu",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {"dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"", "dev:api": "npm --workspace backend run dev", "dev:web": "npm --workspace frontend run dev", "build": "npm --workspace backend run build && npm --workspace frontend run build"},
  "devDependencies": {"concurrently": "^9.1.2", "typescript": "^5.7.3"}
}
